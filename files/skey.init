# skey 开机初始化脚本
# 功能：开机时执行一次 /usr/bin/skey init，幂等。
#   - 首次开机：生成 UUID + RSA 密钥对并写入 product-uid / product-backup
#   - 已初始化：skey init 直接返回，不重写分区
# 这是一次性任务（执行完即退出），不使用 procd 常驻。

START=99

start() {
	/usr/bin/skey init >/dev/null 2>&1
	if [ "$?" = "0" ]; then
		logger -t skey "skey init: OK"
	else
		logger -t skey "skey init: FAILED (run 'skey init' manually for details)"
	fi
}
